{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lp-mock",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8765
    },
    {
      "name": "gui-preview",
      "runtimeExecutable": "mise",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 8080
    },
    {
      "name": "gui-preview-github",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PREVIEW_UPDATE=github",
        "mise",
        "run",
        "preview"
      ],
      "port": 8080
    }
  ]
}
